<Window x:Class="Inventory.Views.CategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories" Width="380" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="CategoriesDialog">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" Margin="0" AutomationProperties.AutomationId="CloseCategoriesButton"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <Label Content="_New category" Target="{Binding ElementName=NewCategoryBox}" Padding="0" Margin="0,10,0,0"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" Margin="8,2,0,8" Command="{Binding AddCommand}" AutomationProperties.AutomationId="AddCategoryButton"/>
                <TextBox x:Name="NewCategoryBox" Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NewCategoryBox" AutomationProperties.Name="New category"/>
            </DockPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" AutomationProperties.AutomationId="CategoryError"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Categories}" AutomationProperties.AutomationId="CategoriesList" AutomationProperties.Name="Categories"/>
    </DockPanel>
</Window>
