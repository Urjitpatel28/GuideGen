<Window x:Class="Inventory.Views.ReceiveStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receive stock" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="ReceiveStockDialog">
    <StackPanel Margin="20">
        <TextBlock x:Name="ItemText" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <Label Content="_Quantity received" Target="{Binding ElementName=ReceivedBox}" Padding="0"/>
        <TextBox x:Name="ReceivedBox" Text="1" AutomationProperties.AutomationId="ReceivedBox" AutomationProperties.Name="Quantity received"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" AutomationProperties.AutomationId="ReceivedError"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add to stock" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" AutomationProperties.AutomationId="AddToStockButton"/>
            <Button Content="Cancel" IsCancel="True" Margin="0" AutomationProperties.AutomationId="CancelReceiveButton"/>
        </StackPanel>
    </StackPanel>
</Window>
