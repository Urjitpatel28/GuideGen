<Window x:Class="Inventory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in - Stockroom Inventory" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AutomationProperties.AutomationId="LoginWindow" FocusManager.FocusedElement="{Binding ElementName=UserNameBox}">
    <StackPanel Margin="28">
        <Image Source="/Assets/logo.png" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <TextBlock Text="Sign in to Stockroom Inventory" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,16"/>
        <Label Content="_User name" Target="{Binding ElementName=UserNameBox}" Padding="0"/>
        <TextBox x:Name="UserNameBox" AutomationProperties.AutomationId="UserNameBox" AutomationProperties.Name="User name"/>
        <Label Content="_Password" Target="{Binding ElementName=PasswordBox}" Padding="0"/>
        <PasswordBox x:Name="PasswordBox" Padding="4,3" Margin="0,2,0,8" AutomationProperties.AutomationId="PasswordBox" AutomationProperties.Name="Password"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.AutomationId="LoginError"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sign in" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="SignIn_Click" AutomationProperties.AutomationId="SignInButton"/>
            <Button Content="Cancel" IsCancel="True" Margin="0" AutomationProperties.AutomationId="CancelButton"/>
        </StackPanel>
    </StackPanel>
</Window>
